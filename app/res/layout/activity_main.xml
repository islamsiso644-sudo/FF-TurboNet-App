<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="rtl"
        android:padding="14dp">

        <!-- العنوان -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:text="@string/title"
            android:textColor="@color/accent2"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:text="@string/subtitle"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <!-- شارة الحالة -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="10dp"
            android:gravity="center"
            android:text="@string/legal_note"
            android:textColor="@color/green"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <!-- شبكة الأزرار: فحص البينق + DNS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPing"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_bg"
                android:text="@string/btn_ping"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:onClick="onPing" />

            <Button
                android:id="@+id/btnDns"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_bg"
                android:text="@string/btn_dns"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:onClick="onDns" />
        </LinearLayout>

        <!-- تحسينات TCP + وضع اللعب -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnTune"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_accent"
                android:text="@string/btn_tune"
                android:textColor="#0D1117"
                android:textSize="14sp"
                android:onClick="onTune" />

            <Button
                android:id="@+id/btnGame"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_accent"
                android:text="@string/btn_game"
                android:textColor="#0D1117"
                android:textSize="14sp"
                android:onClick="onGame" />
        </LinearLayout>

        <!-- مراقبة + تراجع -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnMonitor"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_bg"
                android:text="@string/btn_monitor"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:onClick="onMonitor" />

            <Button
                android:id="@+id/btnUndo"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_bg"
                android:text="@string/btn_undo"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:onClick="onUndo" />
        </LinearLayout>

        <!-- نسخ + مشاركة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_bg"
                android:text="@string/btn_copy"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:onClick="onCopy" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_bg"
                android:text="@string/btn_share"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:onClick="onShare" />
        </LinearLayout>

        <!-- تحسين بدون روت -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnNoRoot"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_accent"
                android:text="🔧 تحسين بدون روت"
                android:textColor="#0D1117"
                android:textSize="13sp"
                android:onClick="onNoRoot" />

            <Button
                android:id="@+id/btnGuide"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_bg"
                android:text="📖 دليل اللعبة"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:onClick="onGameGuide" />
        </LinearLayout>

        <!-- إجراءات سريعة بدون روت -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnPrivateDns"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_bg"
                android:text="🌐 Private DNS"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                android:onClick="onPrivateDns" />

            <Button
                android:id="@+id/btnWifi"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_bg"
                android:text="📶 إعدادات Wi-Fi"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                android:onClick="onWifi" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_bg"
                android:text="🔋 استثناء البطارية"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                android:onClick="onBattery" />

            <Button
                android:id="@+id/btnBgData"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_bg"
                android:text="🚫 بيانات الخلفية"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                android:onClick="onBgData" />
        </LinearLayout>

        <!-- منطقة النتائج -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="━━━ النتائج ━━━"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:gravity="start"
            android:text="جاهز. اختر فحصًا من الأزرار بالأعلى…"
            android:textColor="@color/text_main"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <!-- التنبيه القانوني -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:padding="10dp"
            android:text="@string/disclaimer"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
